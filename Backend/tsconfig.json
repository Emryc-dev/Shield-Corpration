{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "src",
        "prisma",
        "tests",
        "prisma.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
