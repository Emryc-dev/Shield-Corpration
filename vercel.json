{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix 'the-shield-corporation (2)' ci --include=dev",
  "buildCommand": "npm --prefix 'the-shield-corporation (2)' run build",
  "outputDirectory": "the-shield-corporation (2)/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
